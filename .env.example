# ============================================
# AI Content OS - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Server ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-string
DEBUG=true

# --- Database ---
DATABASE_URL=sqlite:///./ai_content_os.db

# --- AI Providers ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- TTS ---
TTS_API_KEY=
TTS_PROVIDER=elevenlabs

# --- Image Generation ---
IMAGE_API_KEY=
IMAGE_PROVIDER=stability

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=100

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO

# --- Redis (optional) ---
REDIS_URL=redis://localhost:6379/0
